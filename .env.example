# iCompass Seychelles - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Node Environment
NODE_ENV=development
VITE_APP_ENV=development

# Supabase Configuration
VITE_SUPABASE_URL=https://bwlmlniotyrjttglbjrl.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Site Configuration
VITE_SITE_URL=http://localhost:5173

# External API Keys
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
RESEND_API_KEY=your_resend_api_key_here

# Development Settings
VITE_DEBUG=false
VITE_LOG_LEVEL=info

# Security Notes:
# - Never commit the actual .env file to version control
# - Keep all API keys secure and rotate them regularly
# - Use different keys for development and production environments
# - The Supabase URL is safe to expose (it's public)
# - The anon key is safe to expose (it's designed for client-side use)
