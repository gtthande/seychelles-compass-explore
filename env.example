# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Storage Buckets (optional - defaults will be used if not set)
VITE_IMAGE_BUCKET_CATEGORIES=category-images
VITE_IMAGE_BUCKET_PRODUCTS=product-images
VITE_IMAGE_BUCKET_REVIEWS=review-images
VITE_IMAGE_BUCKET_AVATARS=avatars

# Google Maps API
VITE_GOOGLE_MAPS_API_KEY=AIzaSyByNrxUDO-dODXwTaT6RINSbAfASZ-eGfY

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here

# Email Service (Resend)
RESEND_API_KEY=your-resend-api-key-here

# Site Configuration
VITE_SITE_URL=https://your-domain.vercel.app

# Vercel Configuration (for GitHub Actions)
VERCEL_TOKEN=your-vercel-token-here
VERCEL_ORG_ID=your-vercel-org-id-here
VERCEL_PROJECT_ID=your-vercel-project-id-here
VERCEL_SCOPE=your-vercel-scope-here

# Development Configuration
NODE_ENV=development
VITE_DEV_MODE=true

# Dev Sync Panel (Admin only)
ALLOW_SYNC=1
SYNC_SERVER_PORT=3001

# MySQL Backup Configuration (Optional)
# Enable MySQL backup: set to 'true' to enable
VITE_ENABLE_MYSQL_BACKUP=false

# Local MySQL (XAMPP) Configuration
VITE_MYSQL_HOST=localhost
VITE_MYSQL_PORT=3306
VITE_MYSQL_USER=root
VITE_MYSQL_PASSWORD=
VITE_MYSQL_DATABASE=icompass
VITE_MYSQL_SSL=false

# Remote MySQL (Hostinger) Configuration
# Uncomment and configure for production:
# VITE_MYSQL_HOST=your-hostinger-host.com
# VITE_MYSQL_PORT=3306
# VITE_MYSQL_USER=your-mysql-user
# VITE_MYSQL_PASSWORD=your-mysql-password
# VITE_MYSQL_DATABASE=icompass
# VITE_MYSQL_SSL=true

# Backend MySQL Config (for Edge Functions)
# These are used by Supabase Edge Functions, not exposed to client
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=icompass
MYSQL_SSL=false
