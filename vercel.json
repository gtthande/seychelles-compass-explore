{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "env": {
    "VITE_SUPABASE_URL": "https://bwlmlniotyrjttglbjrl.supabase.co",
    "VITE_SITE_URL": "https://seychelles-compass-explore.vercel.app"
  },
  // ⚠️ SECURITY: Never commit API keys here. 
  // Configure VITE_SUPABASE_ANON_KEY and other secrets via Vercel Dashboard:
  // Project Settings → Environment Variables
  // Or use: vercel env add VITE_SUPABASE_ANON_KEY
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
